# Sao chép thành .env: cp .env.example .env

# ---- Kafka ----
KAFKA_PORT=9092
KAFKA_UI_PORT=8088
KAFKA_PARTITIONS=3
# Giới hạn dung lượng topic khi dev (byte). 2 GiB
KAFKA_RETENTION_BYTES=2147483648

# ---- Redis ----
REDIS_PORT=6379

# ---- Postgres (profile: db) ----
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker
POSTGRES_PORT=5432

# ---- ClickHouse (profile: db) ----
CLICKHOUSE_USER=tracker
CLICKHOUSE_PASSWORD=tracker
CLICKHOUSE_DB=tracker
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# ---- Observability (profile: obs) ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
